[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "fastrda"]
	path = fastrda
	url = https://github.com/cran/fastrda
[submodule "odetector"]
	path = odetector
	url = https://github.com/zcebeci/odetector
[submodule "osktnorm"]
	path = osktnorm
	url = https://github.com/zcebeci/osktnorm
